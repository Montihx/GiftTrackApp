# /workspace/.env.example — скопируйте в .env и заполните реальными значениями

# --- Telegram Bot ---
BOT_TOKEN=123456:ABC-your-bot-token

# --- Telethon userbot (только фоновый resolver, cold path) ---
API_ID=00000000
API_HASH=your_api_hash
PHONE=+79990000000

# Пароль Postgres (должен совпадать с паролем в DB_URL)
DB_PASS=pass

# --- База данных / Redis (внутри docker-compose сети) ---
DB_URL=postgresql+asyncpg://gt:pass@postgres/gifttrack
REDIS_URL=redis://redis:6379/0

# --- TWA ---
TWA_URL=https://your-domain.com
# Секрет для валидации initData = HMAC-SHA256(key="WebAppData", bot_token)
# Формируется автоматически из BOT_TOKEN, но можно задать явно:
TWA_AUTH_SECRET=

# --- CryptoBot (оплата подписки) ---
CRYPTOBOT_TOKEN=your_cryptobot_api_token
CRYPTOBOT_WEBHOOK_SECRET=generate_random_secret_for_x-webhook-secret
# Тестовая сеть CryptoBot (@CryptoTestnetBot): https://testnet-pay.crypt.bot/api
CRYPTOBOT_API_URL=https://pay.crypt.bot/api

# --- Маркетплейсы / внешние API ---
GETGEMS_WS_URL=wss://api.getgems.io/graphql
GETGEMS_API_URL=https://api.getgems.io/graphql
TONVIEWER_API_KEY=
# Ключ TonAPI (tonconsole.com). Пусто -> seed-каталог, floors = null
TONAPI_KEY=
# Интервал опроса TonAPI (сек); учитывайте лимиты тарифа tonconsole
TONAPI_POLL_INTERVAL=15
# Лимит запросов к TonAPI на процесс (free-тариф tonconsole = 1 RPS; на платном поднимите)
TONAPI_RPS=0.8
# Страниц по 1000 items на коллекцию за цикл; большие коллекции сканируются за несколько циклов
TONAPI_PAGES_PER_CYCLE=3
# Реальное время: SSE-поток переводов NFT; приоритет скана (без фильтров/избранного — раз в N циклов)
TONAPI_STREAM_ENABLED=true
TONAPI_STREAM_DELAY=2
TONAPI_STREAM_RECHECK=8
TONAPI_COLD_EVERY=3
# Автообнаружение новых коллекций Telegram Gifts (раз в час, 5 страниц NFT минтера Fragment)
TONAPI_DISCOVERY_ENABLED=true
TONAPI_DISCOVERY_INTERVAL=3600
TONAPI_DISCOVERY_PAGES=5
# Tonviewer (listener-ton) выключен по умолчанию — API недоступен
TONVIEWER_ENABLED=false
TONAPI_URL=https://tonapi.io

# Тарифы подписки, $ (30/60/90 дней)
SUB_PRICE_USD_30=49
SUB_PRICE_USD_60=89
SUB_PRICE_USD_90=119
# username владельца без @ — кнопка «Написать владельцу» на экране подписки (build-arg фронтенда)
VITE_OWNER_USERNAME=

# Маркет подарков Telegram (сервис resolver, тот же Telethon-аккаунт)
TG_MARKET_ENABLED=true
TG_MARKET_INTERVAL=2
TG_MARKET_CATALOG_INTERVAL=300
TG_MARKET_MAX_NEW=10
OWNER_LOOKUP_ENABLED=true
OWNER_LOOKUP_TIMEOUT=4
UPGRADE_BURST_MAX=20

# --- Прочее ---
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- Telethon cold path (необязательно, см. README) ---
# BIO_SCAN_DELAY=2.0
# BIO_SCAN_BATCH=100
# BIO_RESCAN_DAYS=7
# BIO_CYCLE_SECONDS=600

# Название нативной монеты в алертах/мини-приложении (TonAPI и GetGems теперь называют её GRAM)
COIN_LABEL=GRAM
TG_FLOOR_SHOW=false

# Флоры MRKT и Portals (вход через их мини-приложения вашим Telegram-аккаунтом; Tonnel не поддерживается)
MARKET_FLOORS_ENABLED=true
MARKET_FLOORS_SOURCES=mrkt,portals

# Шина событий диспетчера (consumer group g:dispatcher)
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_RETRY_BASE=0.5
DISPATCH_CLAIM_IDLE_MS=60000
DISPATCH_DEDUP_TTL=3600

# Лимиты отправки Telegram и доступ по подписке
SEND_RATE_GLOBAL=25
SEND_RATE_USER_SEC=1
SEND_RATE_USER_MIN=20
SUBSCRIPTION_REQUIRED=false

# Если очередь воркера владельцев длиннее — событие не ждёт ответа (защита от отставания диспетчера)
OWNER_LOOKUP_MAX_QUEUE=20

# Апгрейды из Telegram с контактом владельца (источник «Написать владельцу» для АПГРЕЙДА)
TG_UPGRADES_ENABLED=true
TG_UPGRADES_INTERVAL=0.8
TG_UPGRADES_COLD_PER_ROUND=5

# Источники событий: MRKT/Portals — приоритет; блокчейн-листинги и апгрейды выключены (шумят, без контакта владельца)
MARKET_LISTINGS_ENABLED=true
ONCHAIN_LISTINGS_ENABLED=false
ONCHAIN_UPGRADES_ENABLED=false
ONCHAIN_SALES_ENABLED=true

# Мониторинг и алерты администратору (ADMIN_TG_IDS — кому писать)
HEALTH_INTERVAL=60
HEALTH_MAX_LAG=500
HEALTH_MAX_DLQ=20
HEALTH_STALL_MINUTES=15
